# Google Sheets - base64-encoded service account JSON (only needed if the site
# reads Sheets directly for availability fallback; deals mirror via BFF).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The ID of the Google Sheet where leads are stored (from the Sheet URL)
# Tabs: "Applications", "Contact"
LEADS_SHEET_ID=

# SendGrid API key (sends lead-notification emails).
SENDGRID_API_KEY=

# Public site URL (used in emails and traffic-source tracking)
NEXT_PUBLIC_SITE_URL=https://topphysiatrists.com

# big-swing-bff base URL - apply submissions are POSTed to {URL}/api/v1/deals.
BIG_SWING_BFF_URL=https://big-swing-bff-620435948703.us-central1.run.app

# This site's platforms row id in the Big Swing DB.
BIG_SWING_PLATFORM_ID=27